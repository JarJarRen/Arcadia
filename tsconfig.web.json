{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "paths": { "@shared/*": ["./src/shared/*"], "@renderer/*": ["./src/renderer/*"] }
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "test/**/*.tsx",
    "test/renderer/setup.ts",
    "test/fixtures/library.ts"
  ]
}
