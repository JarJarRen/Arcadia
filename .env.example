# Template. Copy to `.env` and fill in:
#
#   cp .env.example .env
#
# `.env` is covered by .gitignore and is never committed.
#
# BOTH KEYS ARE OPTIONAL. Without them Arcadia starts and finds everything
# discoverable locally — installed games from Steam's manifests, Epic's
# catalogue, and EA and Ubisoft from the registry. On the development
# machine that was 105 of 263 games.


# Steam Web API — the owned library and playtime.
#
# Without it Steam shows installed games only, and non-Steam games get no
# metadata: the name matching needs Steam's app list.
#
# Free from https://steamcommunity.com/dev/apikey
# (a Steam account is required; any domain will do)
STEAM_WEB_API_KEY=

# Optional. If absent, Arcadia derives the SteamID64 from Steam's
# loginusers.vdf and picks the most recently signed-in account. Only needed
# when several accounts live on the machine and the wrong one is chosen.
STEAM_ID64=

# SteamGridDB — images for games whose store page no longer exists.
#
# Affects test branches ("Rust - Staging Branch"), discontinued titles and
# older games. On the development machine this closed 15 of 17 artwork
# gaps. Without it: no error, just fewer images.
#
# Free from https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=


# Written by the configuration screen, not by hand.
#
# Its absence is what opens that screen on startup; `true` means the
# question has been answered — whether by entering keys or by skipping.
# Delete the line to be asked again.
ENV_CONFIG_DONE=
